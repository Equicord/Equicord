#!/bin/sh

readVersion() {
    node -p "JSON.parse(require('fs').readFileSync(0, 'utf8')).version" 2>/dev/null
}

version=$(git show :package.json | readVersion)
previous=$(git show HEAD:package.json 2>/dev/null | readVersion)

[ -z "$version" ] || [ "$version" = "$previous" ] && exit 0

npmVersion=$(echo "$version" | cut -d. -f1-3)

for file in packages/discord-types/package.json packages/vencord-types/package.json; do
    node -e '
        const fs = require("fs");
        const [file, version] = process.argv.slice(1);
        fs.writeFileSync(file, fs.readFileSync(file, "utf8").replace(/"version": "[^"]*"/, `"version": "${version}"`));
    ' "$file" "$npmVersion"
    git add "$file"
done
