#!/bin/sh

readVersion() {
    node -p "JSON.parse(require('fs').readFileSync(0, 'utf8')).version" 2>/dev/null
}

version=$(git show HEAD:package.json | readVersion)
previous=$(git show HEAD~1:package.json 2>/dev/null | readVersion)

[ -z "$version" ] || [ "$version" = "$previous" ] && exit 0

git tag -af "v$version" -m "v$version"
